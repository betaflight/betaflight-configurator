{
  "name": "betaflight-app",
  "productName": "Betaflight",
  "displayName": "Betaflight - Configuration and management application",
  "description": "Crossplatform configuration and management application for the Betaflight flight control firmware.",
  "version": "2026.12.0-alpha",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "review": "vite build && vite preview",
    "pretest": "npm run lint",
    "test": "vitest",
    "lint": "eslint src scripts *.mjs && npm run lint:css && npm run typecheck",
    "lint:fix": "eslint src scripts *.mjs --fix",
    "lint:css": "stylelint \"src/**/*.vue\"",
    "typecheck": "vue-tsc --noEmit",
    "generate:build-options": "node scripts/generate-build-options.mjs",
    "generate:debug-modes": "node scripts/generate-debug-modes.mjs",
    "android:dev": "node capacitor.config.generator.mjs --dev && npx cap run android",
    "android:open": "vite build && node capacitor.config.generator.mjs && npx cap open android",
    "android:run": "vite build && node capacitor.config.generator.mjs && npx cap run android",
    "android:sync": "vite build && node capacitor.config.generator.mjs && npx cap sync android",
    "android:release": "vite build && node capacitor.config.generator.mjs && npx cap build android --release",
    "tauri": "tauri",
    "tauri:dev": "node scripts/check-tauri-prereqs.mjs && cross-env TAURI_DEV=1 tauri dev",
    "tauri:build": "node scripts/check-tauri-prereqs.mjs && tauri build",
    "tauri:android:dev": "cross-env TAURI_DEV=1 tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:dev": "cross-env TAURI_DEV=1 tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:prebuild": "node scripts/sync-tauri-version.mjs && vite build",
    "format": "prettier --write \"**/*.{js,mjs,ts,vue,css,less}\"",
    "storybook": "storybook dev -p 6006",
    "prepare": "husky"
  },
  "window": {
    "icon": "images/bf_icon_128.png",
    "id": "main-window",
    "min_width": 1024,
    "min_height": 550,
    "title": "Betaflight App"
  },
  "repository": {
    "type": "git",
    "url": "github.com/betaflight/betaflight-configurator"
  },
  "author": "The Betaflight open source project.",
  "license": "GPL-3.0",
  "engines": {
    "node": "^24.21.0",
    "npm": ">=11.19.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@iconify-json/lucide": "^1.2.101",
    "@nuxt/ui": "^4.11.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "crypto-es": "^3.1.3",
    "d3": "^7.9.0",
    "djv": "^2.1.4",
    "dompurify": "^3.4.13",
    "esptool-js": "^0.6.0",
    "geomagnetism": "^0.2.0",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^4.0.2",
    "i18next-vue": "^5.2.0",
    "inflection": "^3.0.2",
    "jsdom": "^30.0.1",
    "leaflet": "^1.9.3",
    "leaflet-marker-rotation": "^0.4.0",
    "Leaflet.MultiOptionsPolyline": "github:hgoebl/Leaflet.MultiOptionsPolyline",
    "lodash.debounce": "^4.0.8",
    "marked": "^18.0.13",
    "mediabunny": "^1.55.2",
    "multicast-dns": "^7.2.5",
    "ol": "^10.4.0",
    "pinia": "^4.0.3",
    "semver": "^7.7.4",
    "short-unique-id": "^5.2.0",
    "sortablejs": "^1.15.7",
    "suncalc": "^2.0.2",
    "tailwindcss": "^4.1.18",
    "three": "^0.186.0",
    "throttle-debounce": "^5.0.0",
    "tiny-emitter": "^2.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.13",
    "vue-multiselect": "^3.0.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-links": "^10.5.2",
    "@storybook/vue3-vite": "^10.5.2",
    "@tauri-apps/cli": "~2.11.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "inquirer": "^14.2.2",
    "less": "^4.2.2",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.5.2",
    "run-script-os": "^1.1.6",
    "storybook": "^10.5.2",
    "stylelint": "^17.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "workbox-build": {
      "glob": "^13.0.6"
    }
  }
}
